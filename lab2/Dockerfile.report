FROM eclipse-temurin:17-jre

ARG ALLURE_VERSION=2.35.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
    && curl -fsSL \
        "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" \
        -o /tmp/allure.tgz \
    && tar -xzf /tmp/allure.tgz -C /opt \
    && ln -s \
        "/opt/allure-${ALLURE_VERSION}/bin/allure" \
        /usr/local/bin/allure \
    && rm -f /tmp/allure.tgz \
    && rm -rf /var/lib/apt/lists/*
    
COPY lab2/generate-report.sh /usr/local/bin/generate-report.sh

CMD ["/bin/bash", "/usr/local/bin/generate-report.sh"]
