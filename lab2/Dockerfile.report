FROM eclipse-temurin:17-jre
ARG ALLURE_VERSION=2.35.1
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" -o /tmp/allure.tgz \
    && tar -xzf /tmp/allure.tgz -C /opt \
    && ln -s "/opt/allure-${ALLURE_VERSION}/bin/allure" /usr/local/bin/allure \
    && rm -f /tmp/allure.tgz \
    && rm -rf /var/lib/apt/lists/*
CMD ["bash", "-lc", "set -e; mkdir -p /reports/allure-results /reports/history; for file in /reports/junit/unit-TEST*.xml /reports/junit/android-device-*.xml; do if [ -f \"$file\" ]; then cp \"$file\" /reports/allure-results/; fi; done; if [ -d /reports/history/history ]; then cp -a /reports/history/history /reports/allure-results/; fi; allure generate /reports/allure-results --clean -o /reports/allure-report; if [ -d /reports/allure-report/history ]; then cp -a /reports/allure-report/history /reports/history/; fi"]
