# Local development values only. CI lab2 overrides settings with isolated test values.
DATABASE_BACKEND=postgresql
DATABASE_URL=postgresql+psycopg://studymate:studymate@localhost:5432/studymate
MONGO_URL=mongodb://studymate:studymate@localhost:27017/studymate?authSource=admin
MONGO_DATABASE=studymate
JWT_SECRET=PLEASE_CHANGE_TO_A_RANDOM_SECRET_LONGER_THAN_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
FILE_STORAGE_DIR=./storage/files
RUN_MIGRATIONS_ON_STARTUP=true
